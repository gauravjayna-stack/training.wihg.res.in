// WIHG Internship & Dissertation Management System
// Default datasource is SQLite for zero-config local/dev use.
// For production on Postgres, change provider to "postgresql" and set DATABASE_URL
// to a postgres connection string (see DEPLOYMENT_LINUX.md).
//
// NOTE: SQLite's Prisma connector does not support native `enum` types at
// all (even just declaring one fails schema validation), so every field
// that would otherwise be an enum is a plain String here. Valid values are
// documented in comments and enforced in the API layer (zod schemas /
// explicit checks in the route handlers), not by the database itself.
// If you switch provider to "postgresql", you can optionally convert these
// back to real `enum` types for stronger DB-level guarantees.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role: ADMIN | ACCOUNTS | SCIENTIST | STUDENT
// ApplicationType: INTERNSHIP | DISSERTATION
// ApplicationStatus: PENDING_APPROVAL | FEE_PAYMENT_NEEDED | VERIFICATION_PENDING |
//   APPROVED_FOR_JOINING | ONBOARDED | IN_PROGRESS | COMPLETION_PENDING |
//   CERTIFICATE_READY | REJECTED
// PaymentStatus: PENDING | VERIFIED | REJECTED

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String // ADMIN | ACCOUNTS | SCIENTIST | STUDENT
  name         String
  phone        String?
  department   String?
  createdAt    DateTime @default(now())

  scientist        Scientist?
  applications     Application[] @relation("StudentApplications")
  verifiedPayments Payment[]     @relation("VerifiedBy")
}

model Scientist {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  name           String
  specialization String
  email          String
  availableSeats Int      @default(0)
  applications   Application[]
}

model Application {
  id                  String    @id @default(cuid())
  studentId           String
  student             User      @relation("StudentApplications", fields: [studentId], references: [id])
  type                String // INTERNSHIP | DISSERTATION
  scientistId         String?
  scientist           Scientist? @relation(fields: [scientistId], references: [id])
  autoAssignRequested Boolean   @default(false)
  status              String    @default("PENDING_APPROVAL")
  collegeName         String
  topic               String?
  durationMonths      Int
  startDate           DateTime?
  endDate             DateTime?
  feeWaived           Boolean   @default(false)
  waiverReason        String?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payment     Payment?
  joining     JoiningRecord?
  certificate Certificate?
}

model Payment {
  id            String    @id @default(cuid())
  applicationId String    @unique
  application   Application @relation(fields: [applicationId], references: [id])
  utrNumber     String
  receiptFile   String
  amount        Float
  status        String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  verifiedById  String?
  verifiedBy    User?     @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model JoiningRecord {
  id                         String   @id @default(cuid())
  applicationId              String   @unique
  application                Application @relation(fields: [applicationId], references: [id])
  joiningDate                DateTime
  physicalVerificationStatus String   @default("PENDING") // PENDING | VERIFIED
  idProofFile                String?
  feeReceiptFile             String?
  createdAt                  DateTime @default(now())
}

model Certificate {
  id                String   @id @default(cuid())
  applicationId     String   @unique
  application       Application @relation(fields: [applicationId], references: [id])
  uniqueCertNo      String   @unique
  issueDate         DateTime @default(now())
  qrCodeUrl         String
  pdfPath           String?
  reportFilePath    String?
  scientistSignoff  Boolean  @default(false)
  adminApproved     Boolean  @default(false)
  feedbackSubmitted Boolean  @default(false)
}
