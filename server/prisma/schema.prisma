generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTS
  SCIENTIST
  STUDENT
}

enum ApplicationType {
  INTERNSHIP
  DISSERTATION
}

enum ApplicationStatus {
  PENDING_SCIENTIST
  PENDING_APPROVAL
  FEE_PAYMENT_NEEDED
  VERIFICATION_PENDING
  APPROVED_FOR_JOINING
  ONBOARDED
  IN_PROGRESS
  COMPLETION_PENDING
  CERTIFICATE_READY
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role
  name         String
  phone        String?
  department   String?
  collegeName  String?
  degreeName   String?
  degreeType   String?
  createdAt    DateTime      @default(now())

  scientist        Scientist?
  applications     Application[] @relation("StudentApplications")
  verifiedPayments Payment[]     @relation("VerifiedBy")
}

model Scientist {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  name           String
  specialization String
  email          String
  availableSeats Int           @default(0)
  applications   Application[]
}

model Application {
  id                    String            @id @default(cuid())
  studentId             String
  student               User              @relation("StudentApplications", fields: [studentId], references: [id])
  type                  ApplicationType
  scientistId           String?
  scientist             Scientist?        @relation(fields: [scientistId], references: [id])
  autoAssignRequested   Boolean           @default(false)
  status                ApplicationStatus @default(PENDING_APPROVAL)
  
  // Student Profile / Application Form Details
  year                  String?
  fullName              String?
  email                 String?
  phoneNo               String?
  collegeName           String
  degreeName            String?
  degreeType            String?
  fatherOrHusbandName   String?
  addressCorrespondence String?
  addressPermanent      String?
  dob                   DateTime?
  placeOfBirth          String?
  ageYears              Int?
  ageMonths             Int?
  ageDays               Int?
  gender                String?
  maritalStatus         String?
  identificationMark    String?
  nationality           String?
  category              String?
  academicRecords       String?           // JSON String
  punishedDetails       String?
  prizesAndAwards       String?
  specialTraining       String?
  researchInterest      String?

  durationMonths        Int
  topic                 String?
  startDate             DateTime?
  endDate               DateTime?
  feeWaived             Boolean           @default(false)
  waiverReason          String?
  rejectionReason       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  payment               Payment?
  joining               JoiningRecord?
  certificate           Certificate?
}

model Payment {
  id            String        @id @default(cuid())
  applicationId String        @unique
  application   Application   @relation(fields: [applicationId], references: [id])
  utrNumber     String
  receiptFile   String
  amount        Float
  status        PaymentStatus @default(PENDING)
  verifiedById  String?
  verifiedBy    User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
}

model JoiningRecord {
  id                         String      @id @default(cuid())
  applicationId              String      @unique
  application                Application @relation(fields: [applicationId], references: [id])
  joiningDate                DateTime
  physicalVerificationStatus String      @default("PENDING")
  idProofFile                String?
  feeReceiptFile             String?
  createdAt                  DateTime    @default(now())
}

model Certificate {
  id                String      @id @default(cuid())
  applicationId     String      @unique
  application       Application @relation(fields: [applicationId], references: [id])
  uniqueCertNo      String      @unique
  issueDate         DateTime    @default(now())
  qrCodeUrl         String
  pdfPath           String?
  reportFilePath    String?
  scientistSignoff  Boolean     @default(false)
  adminApproved     Boolean     @default(false)
  feedbackSubmitted Boolean     @default(false)
}