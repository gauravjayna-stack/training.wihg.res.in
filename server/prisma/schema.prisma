datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   // STUDENT, SCIENTIST, ACCOUNTS, ADMIN
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile   StudentProfile?
  scientistProfile ScientistProfile?
  auditLogs        AuditLog[]
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  university     String?
  college        String?
  course         String?
  discipline     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications   Application[]
}

model ScientistProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    String?
  maxStudents   Int      @default(5)
  signaturePath String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedApplications Application[]
}

model AdminSignature {
  id        String   @id @default(uuid())
  type      String   @unique // DIRECTOR, COORDINATOR
  name      String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id                  String   @id @default(uuid())
  studentId           String
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scientistId         String?
  scientist           ScientistProfile? @relation(fields: [scientistId], references: [id], onDelete: SetNull)
  
  programme           String   // Internship, Dissertation
  topic               String?
  proposedStartDate  DateTime?
  proposedEndDate    DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  status              String   @default("SUBMITTED") // SUBMITTED, APPROVED_SCIENTIST, FEE_VERIFIED, JOINED, REJECTED, COMPLETED
  
  feeStatus           String   @default("PENDING") // PENDING, PAID, VERIFIED, WAIVED
  utrNumber           String?
  receiptPath         String?
  feeWaived           Boolean  @default(false)
  waiverReason        String?

  joiningSubmitted    Boolean  @default(false)
  joiningDate         DateTime?

  reportAbstract      String?
  reportPdfPath       String?
  feedback            String?

  isLocked            Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  weeklyProgresses    WeeklyProgress[]
  certificateApproval CertificateApproval?
  reportUploads       ReportUpload[]
}

model WeeklyProgress {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  weekNumber    Int
  statusLabel   String      // e.g., "Week 1 Completed", "Literature Review"
  remarks       String?
  updatedBy     String
  createdAt     DateTime    @default(now())
}

model CertificateApproval {
  id               String      @id @default(uuid())
  applicationId    String      @unique
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  certificateNo    String      @unique
  studentName      String
  scientistName    String
  university       String
  college          String
  course           String
  topic            String
  duration         String
  issueDate        DateTime    @default(now())
  
  supervisorName   String?
  coordinatorName  String?
  directorName     String?
  
  remarks          String?
  status           String      @default("PENDING_ADMIN") // PENDING_ADMIN, GENERATED, ISSUED, REJECTED
  pdfPath          String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ReportUpload {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  filePath      String
  uploadedBy    String      // SCIENTIST, STUDENT, ADMIN
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime @default(now())
}
