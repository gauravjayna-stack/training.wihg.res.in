# --- Database ---
# prisma/schema.prisma is set to provider = "postgresql", so DATABASE_URL
# must be a Postgres connection string (see docker-compose.yml or
# DEPLOYMENT_LINUX.md to stand one up). If you want to use SQLite instead
# for local development, change the datasource provider in schema.prisma
# back to "sqlite" first — a Postgres-configured schema will fail to
# migrate against a file: URL.
DATABASE_URL="postgresql://wihg_user:CHANGE_ME@localhost:5432/wihg_db?schema=public"

# --- Auth ---
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="8h"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
PUBLIC_BASE_URL="http://localhost:4000"

# --- Email (SMTP) ---
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@wihg.res.in"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="WIHG Training Cell <notifications@wihg.res.in>"

# --- Seed admin account (used only by prisma/seed.js) ---
SEED_ADMIN_EMAIL="admin@wihg.res.in"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
